#!/bin/busybox sh
echo "endroid-os: /init start"
/bin/busybox mkdir -p /proc /sys /dev /tmp /run /dev/pts
/bin/busybox mount -t proc proc /proc
/bin/busybox mount -t sysfs sys /sys
/bin/busybox mount -t devtmpfs dev /dev 2>/dev/null || /bin/busybox mount -t tmpfs tmpfs /dev
/bin/busybox mount -t devpts devpts /dev/pts 2>/dev/null || true
/bin/busybox mount -t tmpfs tmpfs /tmp
/bin/busybox mount -t tmpfs tmpfs /run
/bin/busybox hostname endroid
echo "endroid-os: sysinit ok"
exec /usr/local/bin/endroid-session
